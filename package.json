{
  "name": "roomnote",
  "version": "2.0.0",
  "description": "Offline meeting transcription — no internet required after setup",
  "main": "main.js",
  "author": "Lennox Digital Systems",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --universal --publish never"
  },
  "build": {
    "appId": "za.co.lennoxdigital.roomnote",
    "productName": "RoomNote",
    "copyright": "Copyright © 2026 Lennox Digital Systems",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "whisper-worker.js",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!node_modules/**/*.md",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!**/.git/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 180, "y": 200, "type": "file" },
        { "x": 480, "y": 200, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 660, "height": 400 }
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
