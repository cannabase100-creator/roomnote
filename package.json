{
  "name": "roomnote",
  "version": "1.0.0",
  "description": "Professional meeting transcription with speaker identification and inline notes",
  "main": "main.js",
  "author": "Cannabase <hello@cannabase.co.za>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start":         "electron .",
    "build:mac":     "electron-builder --mac --universal --publish never",
    "build:mac-arm": "electron-builder --mac --arm64 --publish never",
    "build:mac-x64": "electron-builder --mac --x64 --publish never",
    "build:win":     "electron-builder --win --x64 --publish never",
    "build:all":     "electron-builder --mac --universal --win --x64 --publish never"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "docx": "^8.5.0"
  },
  "devDependencies": {
    "electron":         "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId":       "za.co.cannabase.roomnote",
    "productName": "RoomNote",
    "copyright":   "Copyright © 2026 Cannabase",
    "directories": {
      "output":          "dist",
      "buildResources":  "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@xenova/transformers/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      { "from": "build/ollama/",         "to": "ollama/",         "filter": ["**/*"] },
      { "from": "build/ollama-models/",  "to": "ollama-models/",  "filter": ["**/*"] },
      { "from": "build/whisper-models/", "to": "whisper-models/", "filter": ["**/*"] }
    ],

    "mac": {
      "category":          "public.app-category.productivity",
      "icon":              "build/icon.icns",
      "identity":          null,
      "hardenedRuntime":   false,
      "gatekeeperAssess":  false,
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 180, "y": 200, "type": "file" },
        { "x": 480, "y": 200, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 660, "height": 400 }
    },

    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    }
  }
}
